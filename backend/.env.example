# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexora_crm

# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# Media & Storage (Cloudinary CDN - Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Provider Integration (Groq / Gemini / OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Git Webhook Integration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITLAB_WEBHOOK_TOKEN=your_gitlab_webhook_token_here
BITBUCKET_WEBHOOK_SECRET=your_bitbucket_webhook_secret_here
