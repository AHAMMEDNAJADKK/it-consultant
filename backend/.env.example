# ==============================================================================
# IT Consultant — Production / Environment Configuration Template
# ==============================================================================

# Server Hosting Environment (Render Web Service)
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Cross-Origin Resource Sharing (Comma-separated origins, include your Vercel deployment)
ALLOWED_ORIGINS=https://your-crm-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-crm-frontend.vercel.app

# MongoDB Atlas Cloud Database Connection
# Format: mongodb+srv://<DATABASE_USER>:<URL_ENCODED_PASSWORD>@cluster0.xheud1i.mongodb.net/<DATABASE_NAME>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DATABASE_USER>:<URL_ENCODED_PASSWORD>@cluster0.xheud1i.mongodb.net/it_consultant_crm?retryWrites=true&w=majority
# Backwards-compatibility aliases:
MONGO_URI=mongodb+srv://<DATABASE_USER>:<URL_ENCODED_PASSWORD>@cluster0.xheud1i.mongodb.net/it_consultant_crm?retryWrites=true&w=majority
MONGODB_DB_NAME=it_consultant_crm

# Authentication & Security
# Standard symmetric secret (used by bcrypt / session token validation)
JWT_SECRET=your_long_random_jwt_secret_hex_or_passphrase
# Optional asymmetric RSA key pair (if using RS256 token signing)
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Redis Cache & Sliding Session Store (Optional - defaults to graceful memory fallback if unset)
# REDIS_URL=rediss://default:<password>@<redis-host>:6379

# Media & Storage (Cloudinary CDN - Optional for attachments and profile images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Project Health Reports (Groq / Gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Git Integration & Code Auditing Webhook Secrets
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITLAB_WEBHOOK_TOKEN=your_gitlab_webhook_token_here
BITBUCKET_WEBHOOK_SECRET=your_bitbucket_webhook_secret_here
