# Backend API Root Endpoint
# - In local development: /api (proxied automatically via Vite to http://localhost:5000)
# - In Vercel production: https://<your-render-service>.onrender.com/api
VITE_API_URL=https://your-backend-api.onrender.com/api

# Optional Third-Party Communication Integrations
VITE_BREVO_API_KEY=
VITE_EMAIL_SENDER_ADDRESS=no-reply@yourcompany.com
VITE_EMAIL_SENDER_NAME="Nexora IT Suite"
