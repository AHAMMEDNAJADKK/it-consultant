{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix \"front crm\" install",
  "buildCommand": "npm --prefix \"front crm\" run build",
  "outputDirectory": "front crm/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
